{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "editorconfig",
  "rules": {
    "document": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "preamble"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "section"
          }
        }
      ]
    },
    "preamble": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "_body_line"
      }
    },
    "section": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "header",
          "content": {
            "type": "SYMBOL",
            "name": "section_header"
          }
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_body_line"
          }
        }
      ]
    },
    "_body_line": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "blank_line"
        },
        {
          "type": "SYMBOL",
          "name": "comment"
        },
        {
          "type": "SYMBOL",
          "name": "pair"
        }
      ]
    },
    "_end": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "line_ending"
        },
        {
          "type": "SYMBOL",
          "name": "_eof"
        }
      ]
    },
    "blank_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_blank_start"
        },
        {
          "type": "SYMBOL",
          "name": "_end"
        }
      ]
    },
    "comment": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_comment_start"
        },
        {
          "type": "SYMBOL",
          "name": "comment_marker"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "comment_text"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_end"
        }
      ]
    },
    "pair": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_pair_start"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "key",
              "content": {
                "type": "SYMBOL",
                "name": "key"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "FIELD",
          "name": "operator",
          "content": {
            "type": "SYMBOL",
            "name": "assignment_operator"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "value",
              "content": {
                "type": "SYMBOL",
                "name": "value"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_end"
        }
      ]
    },
    "key": {
      "type": "SYMBOL",
      "name": "key_text"
    },
    "value": {
      "type": "SYMBOL",
      "name": "value_text"
    },
    "section_header": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_header_start"
        },
        {
          "type": "FIELD",
          "name": "opening",
          "content": {
            "type": "SYMBOL",
            "name": "section_open"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "name",
              "content": {
                "type": "SYMBOL",
                "name": "pattern"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "FIELD",
          "name": "closing",
          "content": {
            "type": "SYMBOL",
            "name": "section_close"
          }
        },
        {
          "type": "SYMBOL",
          "name": "_end"
        }
      ]
    },
    "pattern": {
      "type": "REPEAT1",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "glob_literal"
          },
          {
            "type": "SYMBOL",
            "name": "wildcard"
          },
          {
            "type": "SYMBOL",
            "name": "recursive_wildcard"
          },
          {
            "type": "SYMBOL",
            "name": "single_character"
          },
          {
            "type": "SYMBOL",
            "name": "path_separator"
          },
          {
            "type": "SYMBOL",
            "name": "escape"
          },
          {
            "type": "SYMBOL",
            "name": "character_set"
          },
          {
            "type": "SYMBOL",
            "name": "alternation"
          },
          {
            "type": "SYMBOL",
            "name": "numeric_range"
          }
        ]
      }
    },
    "character_set": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "opening",
          "content": {
            "type": "SYMBOL",
            "name": "set_open"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "negation",
              "content": {
                "type": "SYMBOL",
                "name": "set_negation"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "set_text"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "FIELD",
          "name": "closing",
          "content": {
            "type": "SYMBOL",
            "name": "set_close"
          }
        }
      ]
    },
    "alternation": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "opening",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "_alternation_open"
            },
            "named": true,
            "value": "brace_open"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "pattern"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT1",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "SYMBOL",
                "name": "alternative_separator"
              },
              {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "pattern"
                  },
                  {
                    "type": "BLANK"
                  }
                ]
              }
            ]
          }
        },
        {
          "type": "FIELD",
          "name": "closing",
          "content": {
            "type": "SYMBOL",
            "name": "brace_close"
          }
        }
      ]
    },
    "numeric_range": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "opening",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "_range_open"
            },
            "named": true,
            "value": "brace_open"
          }
        },
        {
          "type": "FIELD",
          "name": "lower",
          "content": {
            "type": "SYMBOL",
            "name": "integer"
          }
        },
        {
          "type": "SYMBOL",
          "name": "range_separator"
        },
        {
          "type": "FIELD",
          "name": "upper",
          "content": {
            "type": "SYMBOL",
            "name": "integer"
          }
        },
        {
          "type": "FIELD",
          "name": "closing",
          "content": {
            "type": "SYMBOL",
            "name": "brace_close"
          }
        }
      ]
    },
    "_unmatchable": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "PATTERN",
            "value": "[\\s\\S]"
          },
          {
            "type": "PATTERN",
            "value": "[^\\s\\S]"
          }
        ]
      }
    }
  },
  "extras": [
    {
      "type": "SYMBOL",
      "name": "_unmatchable"
    }
  ],
