{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "editorconfig",
      "title": "EditorConfig",
      "scope": "source.editorconfig",
      "path": ".",
      "file-types": [".editorconfig", "editorconfig"],
      "injection-regex": "^editorconfig$",
      "highlights": "queries/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.5.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for EditorConfig.",
    "links": {
      "repository": "https://github.com/konomanoasa/tree-sitter-editorconfig"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false
  }
}
